{
  "tasks": {
    "dev": "deno run --unstable-kv --allow-net --allow-read --watch main.ts",
    "start": "deno run --unstable-kv --allow-net --allow-read main.ts",
    "check": "deno check main.ts",
    "fmt": "deno fmt main.ts",
    "lint": "deno lint main.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lock": false
}
